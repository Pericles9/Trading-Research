      "on_share_median": 1.0,
      "n_onsets": 4,
      "median_lead_in_s_units": 0.5504479946087618,
      "verdict": "DEGENERATE. ON ~100% of the time on real tape, so it emits almost no onsets and no lead is measurable. D's zero is the POISSON identity and this tape sits 1.29 decades below it. The lead figure on a handful of onsets is not a result and is not read.",
      "n_matched_onsets": 4,

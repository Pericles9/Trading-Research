  "read_factors": {
    "asked": "mark bursts where the field is negative AT the s_min line",
    "taken": "built as asked. read_factor = 1.0 is PRIMARY.",
    "read_factor_primary": 1.0,
    "read_factor_overlay": 2.0,
    "overlay_rule": "2.0 renders as a second, legend-toggled trace on the same panes, so the definitional overlap D22 avoided is visible rather than argued about: s_min moves with lambda, so a read taken AT the boundary is partly definitional -- the boundary dropping and the tape speeding up are the same event.",
    "d22_precedent": "D22's work order deliberately read at 2*s_min for that reason. Both are drawn."
  },
  "debounce": {
    "rule": "a minimum on-duration and a merge gap, both from config, both reported in the caption, NOT tuned per event.",
    "min_on_duration_factor": 1.0,
    "merge_gap_factor": 1.0,
    "unit": "multiples of the LOCAL read scale s*(t), taken as the median s* inside the run (or inside the gap) being tested. Local, not global: s* spans two orders of magnitude across an extended session, so one global sample count would over-debounce the bursts and under-debounce the dead stretches.",
    "order": "merge gaps first, then drop short runs.",
    "why_not_tuned": "a feature narrower than the kernel that produced it has not been resolved by that kernel, so an ON run shorter than s* is an artifact of reading a smoothed field on a grid finer than the smoothing. The threshold is s*, which is arithmetic."
  },
  "masking": "field() and field_onesided() return NaN under n_eff >= 8 and MUST NEVER be given a fallback. Cells below their pane's own s_min are masked, not interpolated. At fine scales over a whole session most cells are masked -- that is the correct appearance, not a rendering failure.",
  "not_a_measurement": {
    "not_a_measurement": "no statistic is reported, no threshold is established, no timescale is claimed.",
    "not_evidence_about_tradeability": "D24 and D25 closed that on cost arithmetic and nothing rendered here reopens it. Bursts being visible and bursts being profitable are different claims.",
    "no_forward_returns": "NOT TOUCHED. The moment anything here touches forward returns, the full Agent_Prompt_Standard applies again, pre-registered, no exceptions."
  },

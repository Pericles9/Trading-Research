    "root_cause_diagnosis": {
      "finding": "MSTR/2024-11-11 spot-checked directly: 2,747,522 rows tagged event_date=2024-11-11 in filtered_trades, spanning actual trade dates 2024-11-06..2024-11-08 and 2024-11-12..2024-11-14 - zero rows fall on 2024-11-11 itself, despite MSTR being one of the most liquid tickers in the universe. Not a join bug (verified against raw filtered_trades directly, bypassing the T5 join entirely).",
      "root_cause": "data/collection_scripts/collect_massive_data.py get_trading_window() builds the T-3..T+3 window using pandas.tseries.holiday.USFederalHolidayCalendar via CustomBusinessDay. That calendar includes Columbus Day and Veterans Day as holidays. NYSE/NASDAQ do NOT observe either - both are regular trading days. When a momentum event's date fell on one of these pseudo-holidays, the collector's business-day window silently excluded the genuine event day itself, so it was never collected into the filtered/ folder.",
      "evidence_date_clustering": {
        "2020-10-12": 11,
        "2020-11-11": 5,
        "2021-06-18": 4,
        "2021-10-11": 4,
        "2021-11-11": 5,
        "2021-12-31": 8,
        "2022-10-10": 4,
        "2022-11-11": 21,
        "2023-10-09": 7,
        "2023-11-10": 21,
        "2024-10-14": 18,
        "2024-11-11": 34

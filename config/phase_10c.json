{
  "_file": "config/phase_10c.json",
  "_phase": "10c",
  "_standard": "Agent Prompt Standard v1.3",
  "_governing_documents": [
    "Phase-10c-Prompt.md",
    "Phase-10c-Amendment-A1.md"
  ],
  "_created": "2026-08-23",
  "_note": "Fields with null values are [Cooper] and are never filled by the agent. An empty field required by the current stage is a halt. See Phase-10c-Config-Guide.md for field definitions.",

  "cooper_values": {
    "_class_E_fill_before_stage_0": {
      "D4_median_precision_factor": 1.2,
      "D7_threshold_lo_ms": 10,
      "D7_threshold_hi_s": 10,
      "D8_min_median_duration_s": 30,
      "D9_slope_max": 0.5
    },
    "_class_M_fill_at_stage_0_approval": {
      "D1_sweep_floor_us": null,
      "D2_max_cutoff_ms": null,
      "D11_grid_ceiling_min": null,
      "D14_population": null,
      "D15_stage3_scope": null
    }
  },

  "settled": {
    "D3_window": {
      "basis": "clock_time",
      "centering": "centered",
      "session_boundary": "clip",
      "_forbidden_variants": ["trailing", "anchored_to_detection"]
    },
    "D5_first_kernel_min": 4,
    "D6_stage2_kernels_min": [1, 4, 32],
    "D10_grid": {
      "spacing": "geometric",
      "base": 2,
      "start_min": 1,
      "_ceiling": "D11_grid_ceiling_min"
    },
    "D12_tie_handling": "collapse_same_timestamp",
    "D13_void_parameter": {
      "reported": "continuous",
      "threshold": null,
      "_note": "null here is deliberate and permanent, not a [Cooper] field. The void parameter is never thresholded in this phase."
    }
  },

  "mechanism": {
    "histogram_bin_width_log10": 0.1,
    "peak_finding": {
      "method": "scipy.signal.find_peaks",
      "criterion": "prominence",
      "smoothing": false
    },
    "void_parameter_formula": "1 - f(trough) / sqrt(f(peak_left) * f(peak_right))",
    "threshold_search": {
      "intraburst_peak": "largest peak at interval <= D2_max_cutoff_ms",
      "trough_search_domain": "strictly right of intraburst peak",
      "no_peak_label": "no_intraburst_peak"
    }
  },

  "data": {
    "trades_table": "filtered_trades",
    "quotes_table": "filtered_quotes",
    "universe_view": "momentum_events_canonical",
    "_universe_note": "Materialise once per run. Never call inside a loop; the view runs a live DISTINCT scan over billions of rows.",
    "timestamp_basis": "sip_timestamp",
    "tiebreak": "sequence_number",
    "detection_anchor_variant": "poll0",
    "_detection_anchor_note": "Provisional. Confirmed or revised at Stage 0 approval on the T0.6 migration matrix.",
    "session_calendar": "exchange_calendars:XNYS"
  },

  "quarantine": {
    "_rule": "D4 standing constraint. Display as diagnostic label only. Never enters a computation, filter, sort key, or derived quantity.",
    "columns": [
      "filtered_trades.momentum_pct",
      "spine.open",
      "spine.high",
      "spine.low",
      "spine.close",
      "spine.volume"
    ],
    "verification_required": true
  },

  "dev_sample": {
    "name": "dev_v4_primary",
    "n": 50,
    "seed": 42,
    "stratification": "t0_print_count decile",
    "sidecar_events": {
      "n": 6,
      "disposition": "carry_and_label",
      "reported": "separately_in_every_distribution"
    },
    "_superseded": "dev_sample_v3.json is NOT used in this phase. It carries no detection anchors."
  },

  "stage_0_sweeps": {
    "_note": "Stage 0 reports all candidates and recommends none.",
    "T0_2_candidate_sweep_floors_us": [1, 10, 100, 1000, 10000],
    "T0_3_peak_location_per_floor": true,
    "T0_4_candidate_precision_factors": [1.1, 1.2, 1.3, 1.5],
    "T0_4_sensitivity_kernel_min": 4,
    "T0_5_candidate_kernels_min": [1, 2, 4, 8, 16, 32, 64, 128, 256, 512],
    "T0_6_anchor_variants": ["poll0", "poll1", "poll5", "poll15", "poll60"]
  },

  "gates": {
    "stage_1_scale_sanity": {
      "median_threshold_location": {
        "lo": "D7_threshold_lo_ms",
        "hi": "D7_threshold_hi_s"
      },
      "median_subburst_duration_floor": "D8_min_median_duration_s",
      "evaluated_on": "full_population",
      "evaluated_by": "segment",
      "halt_condition": "either segment out of band"
    },
    "stage_2_scale_coupling": {
      "statistic": "median of per-event log-log slope of threshold location on kernel duration",
      "max": "D9_slope_max",
      "halt_condition": "median slope exceeds max"
    },
    "stage_3": {
      "gate": null,
      "_note": "Descriptive stage. No gate."
    }
  },

  "satisfiability_checks": {
    "_evaluated_per_stage": true,
    "check_2_stage_0_requires": "class_E only",
    "check_2_stage_1_requires": "class_E and class_M, stage 0 approved",
    "check_4_conditions": [
      "D2_max_cutoff_ms exceeds D1_sweep_floor_us by >= 2 orders of magnitude",
      "D7_threshold_lo_ms exceeds D1_sweep_floor_us by >= 1 order of magnitude"
    ],
    "_removed_condition": "The original 'D7 band at or below D2_max_cutoff_ms' condition is REMOVED per Amendment A1.4. It was a mechanism error."
  },

  "reported_not_gated": {
    "implied_min_intervals_per_subburst": "D8_min_median_duration_s / D7_threshold_hi_s",
    "clipped_window_fraction_by_kernel": true,
    "too_few_prints_fraction": true,
    "noncontiguous_kernel_set_fraction": true
  },

  "outputs": {
    "results_root": "results/phase_10c",
    "artifacts": "results/phase_10c/artifacts",
    "charts": "results/phase_10c/charts",
    "digests": "results/phase_10c/digests",
    "change_log": "results/phase_10c/change_log.json",
    "chart_format": "self_contained_html_plotly",
    "dual_y_axis": false
  },

  "git": {
    "branch": "phase-10c",
    "commit_at_task_boundary": true,
    "tags": ["phase-10c-stage0", "phase-10c-stage1", "phase-10c-stage2", "phase-10c-stage3"]
  }
}

# Environments
.venv/

# Local secrets - never committed (Phase 1b Amendment 1: Massive/Polygon API key)
.secrets/

# Data root - never tracked, documented separately in data/Schema.md
# Anchored to repo root (leading /) - unanchored 'data/' would also match
# src/data/, which must be tracked.
/data/

# Independent, already-git-tracked sibling projects - out of scope for this repo
hawkes-ofi-impact/
scanner-epg-momentum/

# Immutable machine-generated run outputs (~1.5GB) - catalogued in
# results/phase_0a/artifacts/inventory_*.json, not tracked in git history
archive/runs/

# Exploratory notebooks - per notebooks/CLAUDE.md, not git-tracked for outputs
notebooks/*.ipynb

# Python
__pycache__/
*.pyc
.pytest_cache/

# Runtime logs (e.g. src/data/ingest.py's LOG_DIR) - regenerable, not source
/logs/

# Per Agent_Prompt_Standard.md v1.3 SS12: artifact parquets are regenerable from
# committed config + code, not source. Applied starting Phase 1 - phase_0c's
# already-tracked artifacts/*.parquet are unaffected and stay committed as-is;
# this pattern only stops *new* untracked parquet artifacts from being added.
results/phase_*/artifacts/*.parquet

# Phase 1c - staged vendor fetch output (raw + aligned parquet per
# (ticker, session) pair, thousands of files). Regenerable via the heal
# manifest + fetch script; the repair ledger is the record, not this.
results/phase_1c/staging/
.duckdb_spill/
results/phase_11/artifacts/_t5b_parts/
run_t5b.sh

# scale_field: same rule as results/phase_*/artifacts/*.parquet above, applied to the
# non-phase folder. Field artifacts are regenerable from committed config + code
# (research/scale_field/run_field_one_event.py). The JSON manifests, which carry every
# n and every provenance field, ARE tracked.
results/scale_field/artifacts/*.parquet

# fundamentals_f1: same rule, applied to this unnumbered work unit. event_fundamentals
# and every companion table are regenerable from the raw archive (data/raw/fundamentals/,
# itself gitignored under /data/) plus committed config + code. digest.json and the
# fetch manifests, which carry every n, checksum, and provenance field, ARE tracked.
results/fundamentals_f1/artifacts/*.parquet
# Underscore-prefixed files under this artifacts/ are internal resumption caches (raw
# per-(ticker,date) API responses so a multi-thousand-call resolution script can restart
# without re-querying everything) -- regenerable by re-running the script, not a finding.
results/fundamentals_f1/artifacts/_*.json
# Same rule, one level deeper: per-CIK parquet parts cached during F1-T3/F1-T4's SEC pulls
# so a multi-thousand-request run can resume without re-fetching. Same pattern as the
# existing results/phase_11/artifacts/_t5b_parts/ entry above.
results/fundamentals_f1/artifacts/_t3_parts/
results/fundamentals_f1/artifacts/_t4_parts/

# Per-event chart HTML plus the 4.8 MB offline plotly.min.js each directory needs
# (D14 forbids a CDN, so the bundle is local and unavoidable). 53 MB for two events,
# regenerable via research/scale_field/plot_scale_field.py. chart_manifest.json is
# tracked so the set is enumerated in git even though the files are not.
results/scale_field/charts/*/*.html
results/scale_field/charts/*/plotly.min.js
# same rule one level deeper, for chart subfolders (event_panels/reference_test/).
# The reference test's PNG is small and IS tracked -- it is the A2-3 evidence.
results/scale_field/charts/*/*/*.html
results/scale_field/charts/*/*/plotly.min.js
results/scope_universe_scan/*.parquet
results/phase_10e/**/*.parquet
results/phase_10e/charts/plotly.min.js

# impact_by_participation, iso_share_hold_length: same rule -- chart HTML is small and
# tracked; only the offline plotly.min.js bundle (D14: no CDN) and regenerable artifact
# parquets are excluded.
results/impact_by_participation/charts/plotly.min.js
results/impact_by_participation/artifacts/*.parquet
results/iso_share_hold_length/charts/plotly.min.js
results/iso_share_hold_length/artifacts/*.parquet
results/reg_sho_201/charts/plotly.min.js
results/reg_sho_201/artifacts/*.parquet
